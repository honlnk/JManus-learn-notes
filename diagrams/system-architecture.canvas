	"nodes":[
		{"id":"4","type":"text","text":"📋 规划系统\n- PlanningFactory (工厂)\n- PlanTemplateService\n- 协调执行机制\n- 模板化管理","x":-1800,"y":-1640,"width":250,"height":180,"color":"3"},
		{"id":"5","type":"text","text":"🔧 工具系统\n- 标准化工具接口\n- 丰富内置工具集\n- 动态工具加载\n- 并行执行支持","x":-1200,"y":-1640,"width":250,"height":180,"color":"4"},
		{"id":"7","type":"text","text":"🔧 配置管理\n- 数据库驱动配置\n- 运行时更新\n- 分组管理\n- 热加载支持","x":-3000,"y":-1280,"width":250,"height":180,"color":"1"},
		{"id":"8","type":"text","text":"🗄️ 数据层\n- H2/MySQL/PostgreSQL\n- JPA/Hibernate\n- 连接池管理\n- 事务处理","x":-2400,"y":-1280,"width":250,"height":180,"color":"2"},
